# Copy this file to .env and fill it in. All three values are PUBLIC (safe in a browser).
# Never put SUPABASE_SECRET_KEY or DATABASE_URL here: those belong to the backend only.

# Your backend: http://localhost:8000 locally, your Render URL in production (no trailing slash)
VITE_API_URL=http://localhost:8000

# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
