# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored. Never commit real keys.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Supabase  (Dashboard -> Project Settings -> API / Data API)
# ---------------------------------------------------------------------------
# Needed from Phase 0. Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Needed from Phase 1. Server-only SECRET key (sb_secret_... or legacy service_role).
# Dashboard -> Project Settings -> API Keys. BACKEND ONLY: never in the frontend, never in git.
SUPABASE_SECRET_KEY=

# Needed from Phase 1. Dashboard -> Connect -> "Transaction pooler" connection string,
# with your database password filled in.
DATABASE_URL=

# Only if your project still uses the LEGACY HS256 JWT secret. Leave empty otherwise.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated frontend origins allowed to call the API (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Limits (defaults tuned for Render free tier, 512 MB RAM)
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=25
# Excel expands much more in memory than CSV, so it has its own lower limit.
MAX_XLSX_UPLOAD_MB=10
MAX_DATASETS_PER_USER=10
MAX_VERSIONS_PER_DATASET=20
# Heavy jobs (upload parsing, later cleaning) run one at a time on 512 MB.
MAX_CONCURRENT_JOBS=1
UPLOADS_PER_HOUR=30
# Excel export is CPU-heavy; above this many cells users are asked to export CSV.
MAX_XLSX_EXPORT_CELLS=1000000

# Caches (safe to leave as-is)
CACHE_MAX_MB=64
FILE_CACHE_DIR=/tmp/insightflow-cache
FILE_CACHE_MAX_MB=512

# ---------------------------------------------------------------------------
# Used ONLY by scripts/get_token.py (local testing). The publishable key is
# public by design (the frontend uses it too).
# ---------------------------------------------------------------------------
SUPABASE_PUBLISHABLE_KEY=
